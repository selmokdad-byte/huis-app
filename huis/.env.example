# Pincode waarmee huisgenoten de app openen (kies iets van minimaal 6 cijfers)
HUIS_PIN=123456

# Home Assistant: adres zoals de server het bereikt, en een token voor lange levensduur
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Pushmeldingen: je e-mailadres als contact voor Apple/Google (verplicht formaat mailto:...)
VAPID_SUBJECT=mailto:jij@example.com

# Alleen voor route B (Cloudflare Tunnel), zie INSTALLEREN.md
# CLOUDFLARE_TUNNEL_TOKEN=

# Optioneel
PORT=8080
TZ=Europe/Amsterdam
# DATA_DIR=./data
